{
  "name": "claude-referee-workspace",
  "version": "0.2.8",
  "private": true,
  "description": "Source, tests and build for the claude-referee Claude Code plugin.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
